generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String    @map("password_hash")
  email        String?
  avatar       String?
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")

  // 自我分析模块
  selfAvatarUrl          String?  @map("self_avatar_url")
  selfDiary              String?  @map("self_diary")            // JSON — 日记条目数组
  selfTraits             String?  @map("self_traits")           // JSON — 九维评分
  selfPersonalitySummary String?  @map("self_personality_summary")
  selfBehaviorPatterns   String?  @map("self_behavior_patterns") // JSON
  selfValues             String?  @map("self_values")            // JSON
  selfAnalysisComplete   Boolean  @default(false) @map("self_analysis_complete")

  characters        Character[]
  simulationSessions SimulationSession[]
  feedbacks         UserFeedback[]

  @@map("users")
}

model Character {
  id                 Int      @id @default(autoincrement())
  userId             Int      @map("user_id")
  name               String
  source             String   // WEB or USER_BUILT
  basicInfo          String?  @map("basic_info")
  traits             String?  // JSON - 九维评分
  personalitySummary String?  @map("personality_summary")
  behaviorPatterns   String?  @map("behavior_patterns")
  values             String?  // JSON
  keyEvents          String?  @map("key_events")
  achievements       String?  // JSON - 主要成就按领域分类
  confidenceScores   String?  @map("confidence_scores")
  isPublic           Boolean  @default(false) @map("is_public")
  viewCount          Int      @default(0) @map("view_count")
  portraitUrl        String?  @map("portrait_url")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  crawlRecords        CrawlRecord[]
  buildSession        BuildSession?
  buildRecords        BuildRecord[]
  simulationSessions  SimulationSession[]
  simulationFeedbacks SimulationFeedback[]
  feedbacks           UserFeedback[]

  @@map("characters")
}

model CrawlRecord {
  id             Int      @id @default(autoincrement())
  characterId    Int      @map("character_id")
  url            String?
  sourceSite     String?  @map("source_site")
  rawContent     String?  @map("raw_content")
  cleanedContent String?  @map("cleaned_content")
  status         String   @default("pending")
  crawledAt      DateTime @default(now()) @map("crawled_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("crawl_records")
}

model BuildSession {
  id           Int       @id @default(autoincrement())
  characterId  Int       @unique @map("character_id")
  currentRound Int       @default(1) @map("current_round")
  isCompleted  Boolean   @default(false) @map("is_completed")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  character Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  records   BuildRecord[]

  @@map("build_sessions")
}

model BuildRecord {
  id              Int      @id @default(autoincrement())
  buildSessionId  Int      @map("build_session_id")
  characterId     Int      @map("character_id")
  roundNumber     Int      @map("round_number")
  userInput       String   @map("user_input")
  extractedTraits String?  @map("extracted_traits")
  aiAnalysis      String?  @map("ai_analysis")
  createdAt       DateTime @default(now()) @map("created_at")

  buildSession BuildSession @relation(fields: [buildSessionId], references: [id], onDelete: Cascade)
  character    Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("build_records")
}

model SimulationSession {
  id           Int       @id @default(autoincrement())
  characterId  Int       @map("character_id")
  userId       Int       @map("user_id")
  sessionTitle String?   @map("session_title")
  sessionType  String    @default("FREE") @map("session_type")
  messages     String?
  settings     String?
  isArchived   Boolean   @default(false) @map("is_archived")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  character Character           @relation(fields: [characterId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedbacks SimulationFeedback[]

  @@map("simulation_sessions")
}

model SimulationFeedback {
  id                    Int      @id @default(autoincrement())
  simulationId          Int      @map("simulation_id")
  characterId           Int      @map("character_id")
  userAction            String   @map("user_action")
  scenario              String?
  predictedReactions    String?  @map("predicted_reactions")
  psychologicalAnalysis String?  @map("psychological_analysis")
  intentionInference    String?  @map("intention_inference")
  adviceGiven           String?  @map("advice_given")
  generatedResponse     String?  @map("generated_response")
  createdAt             DateTime @default(now()) @map("created_at")

  simulation SimulationSession @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  character  Character          @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("simulation_feedbacks")
}

model DimensionDefinition {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  description String?
  minScore    Int     @default(0) @map("min_score")
  maxScore    Int     @default(100) @map("max_score")
  highLabel   String? @map("high_label")
  mediumLabel String? @map("medium_label")
  lowLabel    String? @map("low_label")
  isActive    Boolean @default(true) @map("is_active")

  @@map("dimension_definitions")
}

model UserFeedback {
  id                Int      @id @default(autoincrement())
  characterId       Int      @map("character_id")
  userId            Int      @map("user_id")
  accuracyRating    Int?     @map("accuracy_rating")
  helpfulnessRating Int?     @map("helpfulness_rating")
  satisfactionRating Int?    @map("satisfaction_rating")
  comment           String?
  isResolved        Boolean  @default(false) @map("is_resolved")
  createdAt         DateTime @default(now()) @map("created_at")

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_feedbacks")
}
