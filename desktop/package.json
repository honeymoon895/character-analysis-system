{
  "name": "mindscape-desktop",
  "productName": "读心术",
  "version": "1.0.0",
  "description": "读心术 · Mindscape 桌面版（单机，数据存本机）",
  "author": "Mindscape",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.mindscape.app",
    "productName": "读心术",
    "artifactName": "Mindscape-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "resolve.js",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../out",
        "to": "web"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "读心术",
      "language": "2052"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.lifestyle"
    }
  }
}
