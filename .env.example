# ── Database ──────────────────────────────────────────────
# 本地默认使用 SQLite，无需安装数据库服务
DATABASE_URL="file:./dev.db"

# ── Auth ──────────────────────────────────────────────────
# 生产环境请使用 openssl rand -hex 32 生成强随机值
JWT_SECRET="please-change-me-to-a-long-random-secret"

# ── AI (OpenAI-compatible) ────────────────────────────────
# 不配置时系统会使用内置 mock 数据，便于先跑通流程；
# 配置后启用真实 AI 分析 / 对话 / 画像生成。
AI_API_KEY="sk-your-api-key"
AI_API_URL="https://apihub.agnes-ai.com/v1/chat/completions"
AI_MODEL="agnes-2.0-flash"

# 可选：画像生成模型；不配置时使用默认值
# AI_IMAGE_MODEL="agnes-image-2.1-flash"

# ── Frontend API Base URL ─────────────────────────────────
# 如果站点不在 localhost:3000，需要设置为你的实际访问地址
# NEXT_PUBLIC_BASE_URL="http://localhost:3000"
