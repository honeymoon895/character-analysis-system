# ── Database ──────────────────────────────────────────────
# 本地默认 SQLite，无需安装数据库服务
DATABASE_URL="file:./dev.db"

# ── Auth ──────────────────────────────────────────────────
# 生产环境请用 openssl rand -hex 32 生成
JWT_SECRET="please-change-me-to-a-long-random-secret"

# ── AI（OpenAI 兼容接口）──────────────────────────────────
# 必填。未配置时系统不会伪造分析结果，而是明确提示"未配置 AI 服务"。
AI_API_KEY="sk-your-api-key"
AI_API_URL="https://apihub.agnes-ai.com/v1/chat/completions"
AI_MODEL="agnes-2.0-flash"

# 可选：画像生成模型
# AI_IMAGE_MODEL="agnes-image-2.1-flash"

# ── 前端 API 地址 ─────────────────────────────────────────
# 留空即可：默认使用相对路径，请求会跟随页面来源。
# 这很重要——如果写死 localhost，用手机通过局域网 IP 访问时请求会全部失败。
# 仅当前后端分离部署时才需要设置为独立域名。
# NEXT_PUBLIC_BASE_URL="https://api.example.com"
